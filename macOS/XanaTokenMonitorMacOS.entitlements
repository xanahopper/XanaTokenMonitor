<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- 注意:刻意不加 app-sandbox。主 App 需要派生 codex CLI 子进程,
         沙盒会限制其网络与 ~/.codex 访问;macOS 上 App Groups 不强制沙盒。 -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.xana.token-monitor</string>
    </array>
</dict>
</plist>
